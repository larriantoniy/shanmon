www.shanmon74.ru {
    redir https://shanmon74.ru{uri} permanent
}

shanmon74.ru {
    @xray {
        path /api/system/status
        header Connection *Upgrade*
        header Upgrade websocket
    }
    reverse_proxy @xray 3x-ui:10000

    @sub {
        path /sub/*
    }
    reverse_proxy @sub 3x-ui:2096

    reverse_proxy nginx:80
}