shanmon74.ru {
    log {
        output stdout
        format console
    }

    handle /api/v2/content* {
        reverse_proxy 3x-ui:10001
    }

    handle /api/system/status {
        @websocket {
            header Connection *Upgrade*
            header Upgrade websocket
        }

        reverse_proxy @websocket 3x-ui:10000
        respond 404
    }

    handle /sub/* {
        reverse_proxy 3x-ui:2096
    }

    handle {
        reverse_proxy nginx:80
    }
}